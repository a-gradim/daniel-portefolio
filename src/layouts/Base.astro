---
// Base layout (stub from phase 0 — A3 owns and extends it; keep the theme bootstrap script).
import '../styles/tokens.css';
import { getSettings } from '../lib/content';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  image?: string;
}
const { locale, title, description } = Astro.props;
const settings = await getSettings();
const pageTitle = title ? `${title} — ${settings.name}` : settings.name;
---
<!doctype html>
<html lang={locale === 'pt' ? 'pt-PT' : 'en'} data-theme={settings.defaultTheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
