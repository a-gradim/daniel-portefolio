---
import { Image, getImage } from 'astro:assets';
import { localePath, useT, ytLabels, type Locale } from '../../i18n/ui';
import { md, mediaEdges, pick, projectMedia, youtubeId, type Project } from '../../lib/content';
import { layoutScatter, shuffle } from './layout';

interface Props { projects: Project[]; locale: Locale }
const { projects, locale } = Astro.props;
const t = useT(locale);

const featured = projects.filter((p) => p.data.featured);
const groups = featured.map((p) => ({ p, media: projectMedia(p) }));

// Every media item appears exactly once; the shuffle mixes all projects together.
const flat = groups.flatMap(({ p, media }) => media.map((m, i) => ({ p, m, i })));
const list = shuffle(flat, 17);
// Idle drift per tile (CSS animation) + parallax depth (--z, used with the pointer in canvas.ts).
const motion = (k: number, z: number) => {
  const h = (n: number) => ((Math.sin(k * 12.9898 + n * 78.233) * 43758.5453) % 1 + 1) % 1;
  const amp = 5 + z * 9;
  return `z-index:${Math.round(z * 100)};--z:${z};--ax:${((h(1) - 0.5) * 2 * amp).toFixed(1)}px;--ay:${((h(2) - 0.5) * 2 * amp).toFixed(1)}px;--dd:${(6 + h(3) * 6).toFixed(1)}s;--dl:-${(h(4) * 12).toFixed(1)}s`;
};
const { tiles, W, H } = layoutScatter(list.map((o) => o.m.src.height / o.m.src.width), 23);

// Large versions for the lightbox (the grid itself uses the small widths below).
const full = await Promise.all(
  list.map((o) => getImage({ src: o.m.src, width: 1920, widths: [1280, 1920], sizes: '100vw' })),
);

const projectInfo = groups.map(({ p, media }) => ({
  id: p.id,
  title: p.data.title,
  meta: [p.data.client, pick(p.data.discipline, locale), p.data.year].filter(Boolean).join(' · '),
  credits: (p.data.credits || '').trim(),
  bodyHtml: md(pick(p.data.body, locale)),
  href: localePath(locale, '/work/' + p.id),
  edges: mediaEdges(media),
}));
---
<div class="cv" data-yt-labels={ytLabels(locale)} data-canvas data-w={W} data-h={H}>
  <div class="cv-view" role="region" aria-label={t('canvas.hint')}>
    <div class="cv-layer" style={`width:${W}px;height:${H}px`}>
      <svg class="cv-edges" width={W} height={H} viewBox={`0 0 ${W} ${H}`} aria-hidden="true"></svg>
      {list.map((o, k) => {
        const tl = tiles[k];
        const disc = pick(o.p.data.discipline, locale);
        const label = [o.p.data.title, disc, o.m.kind === 'video' ? t('project.play') : ''].filter(Boolean).join(' — ');
        return (
          <div class="tile" data-p={o.p.id} data-i={o.i} data-rank={o.m.rank} data-kind={o.m.kind}
            data-x={tl.x} data-y={tl.y} data-w={tl.w} data-h={tl.h}
            style={`left:${tl.x}px;top:${tl.y}px;width:${tl.w}px;height:${tl.h}px;${motion(k, tl.z)}`}>
            <a href={localePath(locale, '/work/' + o.p.id)} draggable="false" aria-label={label}
              data-title={o.p.data.title} data-discipline={disc} data-alt={o.m.alt}
              data-full={full[k].src} data-srcset={full[k].srcSet.attribute}
              data-yt={youtubeId(o.m.youtube) ?? undefined} data-vertical={o.m.vertical ? '1' : undefined}>
              <Image src={o.m.src} alt={o.m.alt} width={640} widths={[160, 320, 640, 960]}
                sizes={`${Math.round(tl.w * 0.4)}px`} loading="lazy" decoding="async" draggable="false" />
              {o.m.kind === 'video' && <span class="badge" aria-hidden="true"><svg viewBox="0 0 20 20"><path d="M6 3.5v13l11-6.5z" fill="currentColor" /></svg></span>}
            </a>
            {o.m.seq && <span class="seq" aria-hidden="true">{o.m.seq}</span>}
          </div>
        );
      })}
    </div>
  </div>

  {projectInfo.map((pi) => (
    <template data-panel={pi.id} data-edges={JSON.stringify(pi.edges)}>
      <h2 class="cp-title">{pi.title}</h2>
      {pi.meta && <p class="cp-meta">{pi.meta}</p>}
      {pi.credits && (
        <div class="cp-credits"><span class="cp-label">{t('project.credits')}</span><p>{pi.credits}</p></div>
      )}
      {pi.bodyHtml && <div class="cp-text prose" set:html={pi.bodyHtml} />}
      <a class="cp-link" href={pi.href}>{t('canvas.viewProject')} →</a>
    </template>
  ))}

  <div class="cv-caption" aria-hidden="true"><span class="cv-ct"></span><span class="cv-cd"></span></div>

  <aside class="cv-panel" aria-label={t('canvas.details')} data-panel-el>
    <div class="cp-clip">
      <div class="cp-in">
        <button type="button" class="cp-grab" data-close aria-label={t('a11y.close')}><span></span></button>
        <button type="button" class="cp-x" data-close aria-label={t('a11y.close')}>×</button>
        <div class="cp-scroll" data-panel-content></div>
      </div>
    </div>
  </aside>

  <p class="cv-hint" aria-hidden="true">
    <span class="mouse">{t('canvas.hint')}</span><span class="touch">{t('canvas.hintTouch')}</span>
  </p>
  <div class="cv-zoom">
    <button type="button" data-zoom="out" aria-label={t('canvas.zoomOut')}>−</button>
    <span data-zoom-label>100%</span>
    <button type="button" data-zoom="in" aria-label={t('canvas.zoomIn')}>+</button>
    <button type="button" data-zoom="fit" class="fit" aria-label={t('canvas.fit')} title={`${t('canvas.fit')} (0)`}>
      <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.2">
        <path d="M1 5V1h4M9 1h4v4M13 9v4H9M5 13H1V9" />
      </svg>
    </button>
  </div>

  <div class="cv-lb" role="dialog" aria-modal="true" aria-label={t('canvas.viewer')} hidden>
    <div class="lb-stage" data-lb-stage></div>
    <button type="button" class="lb-btn lb-close" data-lb="close" aria-label={t('a11y.close')}>×</button>
    <button type="button" class="lb-btn lb-prev" data-lb="prev" aria-label={t('project.prev')}>←</button>
    <button type="button" class="lb-btn lb-next" data-lb="next" aria-label={t('project.next')}>→</button>
    <p class="lb-cap"><span data-lb-n></span><span data-lb-t></span></p>
  </div>
  <noscript><style>.cv:not(.is-ready) .tile{opacity:1}</style></noscript>
</div>

<style>
  .cv { position: relative; width: 100%; height: 100%; overflow: clip; background: var(--bg); color: var(--ink); }
  .cv-view {
    position: absolute; inset: 0; overflow: clip; cursor: grab; touch-action: none;
    user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; overscroll-behavior: none;
  }
  .cv.is-dragging .cv-view { cursor: grabbing; }
  .cv-layer { position: absolute; left: 0; top: 0; transform-origin: 0 0; --inv: 1; }
  .cv.is-moving .cv-layer { will-change: transform; }
  .cv-edges { position: absolute; left: 0; top: 0; overflow: visible; pointer-events: none; }
  .cv-edges :global(path) {
    /* Constant ~2px on screen at any zoom (--inv = 1/zoom); dash length set in JS for the draw-on. */
    fill: none; stroke: var(--ink); stroke-width: calc(2px * var(--inv));
    stroke-linecap: round; stroke-linejoin: round; opacity: 0.9;
    transition: stroke-dashoffset 1.4s cubic-bezier(0.65, 0, 0.35, 1) var(--delay, 0s);
  }
  .cv-edges :global(path.done) { transition: none; }

  .badge svg { width: 42%; height: 42%; margin-left: 8%; }
  .tile {
    position: absolute; transition: opacity var(--dur) var(--ease);
    /* Parallax: front tiles (--z ~1) follow the pointer more. --mx/--my are set on the layer by canvas.ts. */
    translate: calc(var(--mx, 0) * var(--z, 0.5) * 28px) calc(var(--my, 0) * var(--z, 0.5) * 28px);
    animation: cv-drift var(--dd, 9s) ease-in-out var(--dl, 0s) infinite alternate;
  }
  @keyframes cv-drift {
    from { transform: translate(calc(var(--ax, 0px) * -1), calc(var(--ay, 0px) * -1)); }
    to { transform: translate(var(--ax, 0px), var(--ay, 0px)); }
  }
  .tile:has(a:hover), .tile:has(a:focus-visible) { z-index: 1000 !important; }
  /* While a project is selected everything holds still so the lines meet the tiles. */
  .cv.has-sel .tile { animation: none; translate: none; }
  .cv:not(.is-ready) .tile { opacity: 0; }
  .cv.has-sel .tile:not(.in-sel) { opacity: 0.12; }
  .tile a { position: relative; container-type: inline-size; display: block; width: 100%; height: 100%; background: var(--surface); cursor: inherit; -webkit-user-drag: none; }
  .tile :global(img) {
    display: block; width: 100%; height: 100%; object-fit: cover; pointer-events: none;
    -webkit-user-drag: none; transition: opacity var(--dur) var(--ease);
  }
  .tile a:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .cv.is-ready .tile a { animation: cv-in var(--dur-slow) var(--ease) backwards; animation-delay: var(--d, 0s); }
  @keyframes cv-in { from { opacity: 0; transform: scale(0.92); } }
  @media (hover: hover) {
    .cv:not(.is-dragging):not(.has-sel) .cv-layer:has(a:hover) .tile a:not(:hover) :global(img) { opacity: 0.35; }
  }

  .badge {
    --b: min(calc(36px * var(--inv)), 42cqw);
    position: absolute; left: 50%; top: 50%; translate: -50% -50%; pointer-events: none;
    width: var(--b); aspect-ratio: 1; border-radius: 50%; display: grid; place-items: center;
    background: var(--ink); color: var(--bg); opacity: 0.92; line-height: 1;
  }
  .seq {
    position: absolute; left: 0; bottom: 100%; pointer-events: none; z-index: 1; display: none;
    transform-origin: 0 100%; transform: scale(var(--inv)); padding: 2px 6px 3px 0; background: var(--bg);
    font-family: var(--font-label); font-size: var(--fs-xs); letter-spacing: var(--tracking-label);
    text-transform: var(--case-label); line-height: 1.2; color: var(--ink); white-space: nowrap;
  }

  .cv-caption, .cv-hint, .cv-zoom {
    font-family: var(--font-label); font-size: var(--fs-xs); letter-spacing: var(--tracking-label);
    text-transform: var(--case-label); line-height: 1.3;
  }
  .cv-caption {
    position: absolute; left: 0; top: 0; z-index: 2; pointer-events: none; opacity: 0;
    padding: var(--space-2) var(--space-3); background: var(--bg); border: 1px solid var(--hair);
    display: flex; flex-direction: column; gap: 2px; max-width: min(320px, 80vw);
    transition: opacity var(--dur-fast) var(--ease);
  }
  .cv.is-hover:not(.is-dragging) .cv-caption { opacity: 1; }
  .cv-ct { color: var(--ink); }
  .cv-cd { color: var(--muted); }
  .cv-cd:empty { display: none; }

  .cv-hint {
    position: absolute; left: 50%; z-index: 2; transform: translateX(-50%); pointer-events: none; color: var(--muted);
    bottom: calc(var(--gutter) + env(safe-area-inset-bottom, 0px)); height: 44px; display: flex; align-items: center;
    white-space: nowrap; margin: 0; opacity: 0; animation: cv-fade var(--dur-slow) var(--ease) 1.2s forwards;
    transition: opacity var(--dur) var(--ease);
  }
  .cv.is-touched .cv-hint, .cv.has-sel .cv-hint { animation: none; opacity: 0; }
  .cv-hint .touch { display: none; }
  @media (pointer: coarse) { .cv-hint .mouse { display: none; } .cv-hint .touch { display: inline; } }
  @media (max-width: 640px) { .cv-hint { bottom: calc(var(--gutter) + 44px + var(--space-2) + env(safe-area-inset-bottom, 0px)); } }
  @keyframes cv-fade { to { opacity: 1; } }

  .cv-zoom {
    position: absolute; z-index: 2; display: flex; align-items: center;
    left: calc(var(--gutter) + env(safe-area-inset-left, 0px)); bottom: calc(var(--gutter) + env(safe-area-inset-bottom, 0px));
    background: var(--bg); border: 1px solid var(--hair);
  }
  .cv-zoom button {
    display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border: 0; background: none;
    color: var(--ink); cursor: pointer; font: inherit; font-size: var(--fs-md); touch-action: manipulation;
  }
  .cv-zoom button.fit { border-left: 1px solid var(--hair); }
  .cv-zoom button:hover { background: var(--surface); }
  .cv-zoom button:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .cv-zoom [data-zoom-label] { min-width: 48px; text-align: center; color: var(--muted); font-variant-numeric: tabular-nums; }

  /* ---- case study panel (screen space; JS sets --px/--py every frame) ---- */
  .cv-panel {
    position: absolute; left: 0; top: 0; z-index: 3; width: 320px; max-height: calc(100% - 128px);
    display: flex; transform: translate3d(var(--px, 0px), var(--py, 0px), 0);
    visibility: hidden; pointer-events: none;
    transition: opacity var(--dur-fast) var(--ease), visibility 0s linear var(--dur);
  }
  .cv-panel.is-open { visibility: visible; pointer-events: auto; transition: opacity var(--dur-fast) var(--ease); }
  @media (max-width: 767px) { :global(html:has(.cv-panel.is-open) [data-toggles]) { opacity: 0; pointer-events: none; } }
  .cv-panel.is-away { opacity: 0; pointer-events: none; }
  .cp-clip {
    display: flex; width: 100%; min-height: 0; clip-path: inset(0 100% 0 0);
    transition: clip-path var(--dur) var(--ease);
  }
  .cv-panel[data-side='left'] .cp-clip { clip-path: inset(0 0 0 100%); }
  .cv-panel.is-open .cp-clip { clip-path: inset(-2px); }
  .cp-in {
    position: relative; display: flex; flex-direction: column; width: 100%; min-height: 0;
    background: var(--bg); border: 1px solid var(--hair); color: var(--ink);
    transform: translateX(-28px); transition: transform var(--dur) var(--ease);
  }
  .cv-panel[data-side='left'] .cp-in { transform: translateX(28px); }
  .cv-panel.is-open .cp-in { transform: none; }
  .cp-grab { display: none; }
  .cp-x {
    position: absolute; right: 0; top: 0; z-index: 1; width: 44px; height: 44px; border: 0; background: none;
    color: var(--ink); font-size: 22px; line-height: 1; cursor: pointer; touch-action: manipulation;
  }
  .cp-x:hover { opacity: 0.6; }
  .cp-x:focus-visible, .cp-grab:focus-visible, .cp-link:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .cp-scroll { overflow-y: auto; overscroll-behavior: contain; padding: var(--space-4) var(--space-4) var(--space-4); min-height: 0; }
  .cp-scroll :global(.cp-title) { font-size: var(--fs-md); font-weight: 500; line-height: 1.25; padding-right: 36px; }
  .cp-scroll :global(.cp-meta), .cp-scroll :global(.cp-label) {
    font-family: var(--font-label); font-size: var(--fs-xs); letter-spacing: var(--tracking-label);
    text-transform: var(--case-label); color: var(--muted); line-height: 1.4;
  }
  .cp-scroll :global(.cp-meta) { margin-top: var(--space-2); }
  .cp-scroll :global(.cp-credits) { margin-top: var(--space-4); }
  .cp-scroll :global(.cp-credits p) { margin-top: var(--space-1); font-size: var(--fs-sm); white-space: pre-line; line-height: 1.45; }
  .cp-scroll :global(.cp-text) { margin-top: var(--space-4); display: grid; gap: var(--space-3); font-size: var(--fs-sm); line-height: 1.55; }
  .cp-scroll :global(.cp-link) {
    display: inline-flex; align-items: center; min-height: 44px; margin-top: var(--space-4);
    font-family: var(--font-label); font-size: var(--fs-xs); letter-spacing: var(--tracking-label);
    text-transform: var(--case-label); border-bottom: 1px solid var(--ink); align-self: flex-start;
  }
  .cp-scroll :global(.cp-link:hover) { opacity: 0.6; }

  @media (max-width: 767px) {
    .cv-panel {
      left: 0; right: 0; top: auto; bottom: 0; width: auto; max-height: 52dvh; transform: translateY(105%);
      transition: transform var(--dur) var(--ease), visibility 0s linear var(--dur);
    }
    .cv-panel.is-open { transform: none; transition: transform var(--dur) var(--ease); }
    .cv-panel.is-away { opacity: 1; pointer-events: auto; }
    .cp-clip, .cv-panel[data-side='left'] .cp-clip { clip-path: none; }
    .cp-in, .cv-panel[data-side='left'] .cp-in { transform: none; border-width: 1px 0 0; }
    .cp-grab {
      display: grid; place-items: center; width: 100%; height: 28px; border: 0; background: none; padding: 0;
      cursor: pointer; touch-action: none; flex: none;
    }
    .cp-grab span { width: 36px; height: 3px; border-radius: 2px; background: var(--hair); }
    .cp-x { top: 0; }
    .cp-scroll { padding: var(--space-1) var(--space-4) calc(var(--space-4) + 44px + env(safe-area-inset-bottom, 0px)); }
    .cv.has-sel .cv-zoom { display: none; }
  }

  /* ---- lightbox ---- */
  .cv-lb {
    position: absolute; inset: 0; z-index: 100; display: grid; place-items: center; background: var(--bg);
    animation: cv-fade-in var(--dur) var(--ease);
  }
  .cv-lb[hidden] { display: none; }
  @keyframes cv-fade-in { from { opacity: 0; } }
  .lb-stage { position: absolute; inset: 72px 0 64px; display: grid; grid-template: minmax(0, 1fr) / minmax(0, 1fr); place-items: center; touch-action: pan-y; padding: 0 56px; }
  .lb-stage :global(img) { max-width: 100%; max-height: 100%; min-height: 0; width: auto; height: auto; object-fit: contain; }
  .lb-stage :global(.lb-frame) { aspect-ratio: 16 / 9; width: min(100%, calc((100dvh - 136px) * 16 / 9)); background: var(--surface); }
  .lb-stage :global(.lb-frame.is-vertical) { aspect-ratio: 9 / 16; width: auto; height: 100%; max-width: 100%; }
  .lb-btn {
    position: absolute; z-index: 1; width: 44px; height: 44px; display: grid; place-items: center; border: 0;
    background: none; color: var(--ink); font-size: 22px; line-height: 1; cursor: pointer; touch-action: manipulation;
  }
  .lb-btn[hidden] { display: none; }
  .lb-btn:hover { opacity: 0.6; }
  .lb-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .lb-close { right: max(var(--gutter), env(safe-area-inset-right)); top: calc(var(--header-h) + 8px); }
  .lb-prev, .lb-next { top: 50%; margin-top: -22px; }
  .lb-prev { left: 4px; }
  .lb-next { right: 4px; }
  .lb-cap {
    position: absolute; left: var(--gutter); right: 120px; bottom: calc(var(--space-3) + env(safe-area-inset-bottom, 0px));
    margin: 0; display: flex; gap: var(--space-3); font-family: var(--font-label); font-size: var(--fs-xs);
    letter-spacing: var(--tracking-label); text-transform: var(--case-label); line-height: 1.3; pointer-events: none;
  }
  .lb-cap [data-lb-n] { color: var(--muted); font-variant-numeric: tabular-nums; flex: none; }

  @media (prefers-reduced-motion: reduce) {
    .cv.is-ready .tile a { animation: none; }
    .tile { animation: none; translate: none; }
    .cv-hint { animation: none; opacity: 1; }
    .cv.is-touched .cv-hint, .cv.has-sel .cv-hint { opacity: 0; }
    .cv-lb { animation: none; }
    .cv-edges :global(path) { transition: none; }
    .cp-clip, .cp-in, .cv-panel { transition: none !important; }
  }
</style>

<script>
  import { initCanvas } from './canvas';

  let cleanup: (() => void) | undefined;
  const init = () => {
    const root = document.querySelector<HTMLElement>('[data-canvas]');
    if (!root || (root as any).__cv) return;
    (root as any).__cv = true;
    cleanup?.();
    cleanup = initCanvas(root);
  };
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => { cleanup?.(); cleanup = undefined; });
  init();
</script>
